<?xml version="1.0" encoding="utf-8" ?>
<Imaginet> 
  <Function unit="Core.IMUnits.GCC_PHAT_4MIC"> <DisplayName>GCC-PHAT 4-Channel</DisplayName> <DisplayPath>/IMUnits</DisplayPath>

    <Description> Computes Generalized Cross-Correlation with Phase Transform (GCC-PHAT) for a 4-channel microphone array using Channel 0 as the reference channel. Outputs 3 cross-correlation curves.

      <Header>C implementation</Header>
      <Inline fragment="gcc_phat_4mic.h:gcc_phat_4mic" language="C" />
    </Description>

    <Parameters>
      <InputSocket name="input" pipe="data" /> <Int32Option name="window_size" min="1" ui="textbox" text="Window Size" description="The frame length of the audio slices processing through the block (e.g. 512, 1024, 2048)." />
      <OutputSocket name="output" shape="[3, window_size]" type="input.type" pipe="data" />
    </Parameters>

    <Contracts> <Assert test="input.shape.flat == (4 * window_size)" error="Input flat array size must match 4 * window_size." />
    </Contracts>

    <Implementations>
      <Implementation language="C" fragment="gcc_phat_4mic.h:gcc_phat_4mic" call="gcc_phat_4mic_f32(input, window_size, output)" />
      <Implementation language="Python" fragment="gcc_phat_4mic.py:gcc_phat_4mic_py" call="compute_gcc_phat_py(input, window_size, output)" />
    </Implementations>

  </Function>
</Imaginet>